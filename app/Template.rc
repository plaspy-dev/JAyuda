        BEGIN
            VALUE "CompanyName", "SDG (Software Developers Group)"
            VALUE "FileDescription", "Programa de ayuda"
            VALUE "FileVersion", "1.1.0.1"
            VALUE "InternalName", "JAyuda.exe"
            VALUE "LegalCopyright", "SDG (Software Developers Group). Reservados todos los derechos."
            VALUE "OriginalFilename", "JAyuda.exe"
            VALUE "ProductName", "Ayuda"
            VALUE "ProductVersion", "1.1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0xc0a, 1252
    END
END


