/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  24, 23
BEGIN
    BUTTON      ID_EDIT_COPY
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Imprimir\tCtrl+P",           57607
        MENUITEM "C&onfigurar Página",          57606
        MENUITEM SEPARATOR
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "A&yuda\tF1",                  ID_AYUDA_AYUDA
        MENUITEM SEPARATOR
        MENUITEM "&Indice\tCtrl+F1",            ID_AYUDA_INDICE
        MENUITEM "&Buscar\tAlt+F1",             ID_AYUDA_BUSCAR
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de JAyuda...",        ID_APP_ABOUT
    END
END

IDR_TemplateTYPE MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Imprimir\tCtrl+P",           57607
        MENUITEM "C&onfigurar Página",          57606
        MENUITEM SEPARATOR
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Copiar\tCtrl+C",             ID_EDIT_COPY
    END
    POPUP "&Ir"
    BEGIN
        MENUITEM "Atras\tAlt+Izquierda",        1111
        MENUITEM "Adelante\tAlt+Derecha",       1112
        MENUITEM "Cancelar\tEscape",            1113
        MENUITEM "Actualizar\tF5",              1114
        MENUITEM "Inicio\tInicio",              1115
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Indice\tCtrl+F1",            ID_AYUDA_INDICE
        MENUITEM "&Buscar\tAlt+F1",             ID_AYUDA_BUSCAR
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de JAyuda...",        ID_APP_ABOUT
    END
END


