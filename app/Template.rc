    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY 
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT
    VK_F1,          ID_AYUDA_INDICE,        VIRTKEY, CONTROL
    VK_F1,          ID_AYUDA_BUSCAR,        VIRTKEY, ALT
    VK_LEFT,        1111,                   VIRTKEY, ALT
    VK_RIGHT,       1112,                   VIRTKEY, ALT
    VK_ESCAPE,      1113,                   VIRTKEY 
    VK_F5,          1114,                   VIRTKEY 
    VK_HOME,        1115,                   VIRTKEY 
    "P",            57607,                  VIRTKEY, CONTROL
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 86
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Acerca de OrganizationExample23"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    RTEXT           "Versión 1.1",IDC_SVERSION,139,20,89,8,SS_NOPREFIX
    RTEXT           "Copyright (C) 2007",IDC_STATIC,139,34,89,8
    DEFPUSHBUTTON   "Aceptar",IDOK,178,63,50,16,WS_GROUP
    LTEXT           "Programado por SDG LTDA. Todos los derechos reservados.",IDC_SLINKEX,35,49,193,8
    ICON            IDR_MAINFRAME,IDC_STATIC,7,7,21,20
    RTEXT           "SDG LTDA. OrganizationExample23",IDC_STATIC,93,7,135,8
END


